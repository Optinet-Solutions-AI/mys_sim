# Copy to .env.local for local development, or set these in the Vercel project settings.
# Phase 1 (browser-only) reads none of them. Phase 2 (shared run history and logs on Supabase) will read:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never prefixed NEXT_PUBLIC_): used by server runs for large sizes, phase 2.
SUPABASE_SERVICE_ROLE_KEY=
